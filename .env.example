# .env — copy to .env and fill in your keys
# Only OPENAI_API_KEY is required; everything else has sensible defaults.

# ── LLM (provider-agnostic: openai + anthropic) ──────────────────────────────
# Default provider used when an agent spec omits one. Each provider has three
# tiers (large / medium / small); agents are assigned a `[provider:]tier` spec
# below, so individual agents can run on different providers and tiers.
# LLM_PROVIDER=openai
# LLM_TEMPERATURE=0.2          # sent to OpenAI; omitted for Anthropic (400 on Opus 4.8/Sonnet 5)
# LLM_MAX_TOKENS=4096          # applied to Anthropic models

OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=           # required only if any agent uses an anthropic spec

# Six model IDs — these DEFINE what each tier means per provider (the per-agent
# specs below just reference the tier). OpenAI tiers fall back to the legacy
# OPENAI_MODEL / OPENAI_MINI_MODEL if set, so existing deployments keep theirs.
# OPENAI_MODEL_LARGE=gpt-4o
# OPENAI_MODEL_MEDIUM=gpt-4o-mini
# OPENAI_MODEL_SMALL=gpt-4o-mini
# ANTHROPIC_MODEL_LARGE=claude-opus-4-8
# ANTHROPIC_MODEL_MEDIUM=claude-sonnet-5
# ANTHROPIC_MODEL_SMALL=claude-haiku-4-5

# ── Per-agent model assignment ───────────────────────────────────────────────
# Each agent's value is a SPEC written as  [provider:]tier
#   provider (optional) = openai | anthropic   (omit → uses LLM_PROVIDER above)
#   tier     (required) = large | medium | small
# The tier just points at the matching *_MODEL_* var above — e.g. `anthropic:large`
# uses ANTHROPIC_MODEL_LARGE. Do NOT put a model id or an env-var name here; a
# value that isn't a valid provider/tier fails fast at startup.
#
#   ✅ large              (tier only → inherits LLM_PROVIDER)
#   ✅ openai:small       (explicit provider + tier)
#   ✅ anthropic:large
#   ❌ ANTHROPIC_MODEL_LARGE   (env-var name — not a tier)
#   ❌ gpt-4o                  (model id — not a tier)
#   ❌ huge                    (not a valid tier)
#
# MIXING is per-agent, not per-tier: you can't say "large=openai, small=anthropic"
# globally, but you CAN give each agent its own provider. Example — consolidator on
# OpenAI's large, all specialists on Anthropic's small (both API keys must be set):
#   LLM_PROVIDER=anthropic          # house provider → specialists default to anthropic:small
#   LLM_CONSOLIDATOR=openai:large   # the exceptions, spelled out
#   LLM_PORTFOLIO=openai:large
#
# Defaults if unset: consolidator/portfolio → large, the six specialists → small
# (each within LLM_PROVIDER). Uncomment only what you want to change.
# LLM_CONSOLIDATOR=large
# LLM_PORTFOLIO=large
# LLM_PRICE_AGENT=small
# LLM_DIVIDEND_AGENT=small
# LLM_MOVEMENT_AGENT=small
# LLM_VALUATION_AGENT=small
# LLM_CONTROVERSY_AGENT=small
# LLM_SENTIMENT_AGENT=small

# Legacy aliases (still honored as fallbacks for the OpenAI tiers above)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2

# ── Web search (optional — graceful degradation when absent) ─────────────────
# TAVILY_API_KEY=
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic

# ── Database ─────────────────────────────────────────────────────────────────
DB_BACKEND=sqlite
SQLITE_PATH=reports.db
# POSTGRES_DSN=postgresql://user:password@localhost:5432/ph_advisor

# ── Docker Compose (only used when running via docker compose) ───────────────
# POSTGRES_USER=ph_advisor
POSTGRES_PASSWORD=change-me-to-a-strong-password
# POSTGRES_DB=ph_advisor
# POSTGRES_PORT=5432

# ── Redis / Celery (required for web UI) ─────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# REDIS_PORT=6379
# WEB_PORT=5180
# ADMIN_PORT=5181

# ── Flask secret key (REQUIRED when auth is enabled) ─────────────────────────
# Generate with: python -c \"import secrets; print(secrets.token_hex(32))\"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# ── Admin panel credentials (REQUIRED for docker compose) ────────────────────
# ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Passkey sign-in (WebAuthn) — primary auth; off unless RP ID is set ───────
# Passkeys BIND to this domain; changing it later invalidates existing passkeys.
# Dev: WEBAUTHN_RP_ID=localhost + WEBAUTHN_ORIGIN=http://localhost:5180
# WEBAUTHN_RP_ID=your.domain.com
# WEBAUTHN_ORIGIN=https://your.domain.com
# WEBAUTHN_RP_NAME=PH Stock Advisor AI

# ── Analysis-result emails (ZeptoMail) — off unless the API key is set ───────
# No key → console sender: emails are logged, not sent (dev/test default).
# ZeptoMail verifies EXACT domains, so the from address must belong to a domain
# verified in the ZeptoMail console. APP_BASE_URL builds the report links in
# emails; it falls back to WEBAUTHN_ORIGIN when unset.
# ZEPTOMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=customer.success@sakayandgo.com
# APP_BASE_URL=https://your.domain.com

# ── Cloudflare Tunnel (prod compose only; off unless the profile is on) ──────
# COMPOSE_PROFILES=tunnel
# CLOUDFLARED_TUNNEL_TOKEN=eyJ...

# ── OAuth recovery sign-ins (optional; keep as fallback for lost devices) ────
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=common
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── API base URLs (override only if you run a local proxy / mirror) ──────────
# DRAGONFI_BASE_URL=https://api.dragonfi.ph/api/v2
# PSE_EDGE_BASE_URL=https://edge.pse.com.ph
# TRADINGVIEW_SCANNER_URL=https://scanner.tradingview.com/philippines/scan

# ── HTTP ─────────────────────────────────────────────────────────────────────
# HTTP_TIMEOUT=15

# ── Timezone (IANA name or UTC/GMT offset, e.g. Asia/Manila, UTC+8) ──────────
# TIMEZONE=Asia/Manila

# ── Output (export directory for PDF / HTML files) ──────────────────────────
# OUTPUT_DIR=              # empty = current directory; set in docker-compose

# ── Analysis thresholds (tune to adjust agent sensitivity) ───────────────────
# TREND_UP_THRESHOLD=5          # % change above which trend = uptrend
# TREND_DOWN_THRESHOLD=-5       # % change below which trend = downtrend
# SPIKE_STD_MULTIPLIER=3        # × daily-return std to flag a spike
# SPIKE_MIN_ABS_RETURN=0.05     # minimum |return| to count as spike
# HIGH_VOLATILITY_THRESHOLD=0.03  # daily std above this = "high volatility"
# OVERVALUATION_MULTIPLIER=1.3  # price / avg > this = overvaluation risk
# DISTRESS_MULTIPLIER=0.7       # price / avg < this = distress risk
# CATALYST_YIELD_THRESHOLD=3.0  # dividend yield (%) to trigger catalyst
# CATALYST_RANGE_PCT=65         # % of 52-week range for catalyst detection
# CATALYST_DAY_CHANGE_PCT=0.5   # daily % change to trigger momentum catalyst
# CATALYST_NEAR_HIGH_PCT=5      # % gap to 52-week high for "near high" catalyst

# ── Verdict score (0–100 buy-decision scale) ─────────────────────────────────
# Final score = weighted average of six LLM sub-scores (weights normalised).
# SCORE_WEIGHT_PRICE=0.15
# SCORE_WEIGHT_VALUATION=0.25
# SCORE_WEIGHT_DIVIDEND=0.15
# SCORE_WEIGHT_MOVEMENT=0.15
# SCORE_WEIGHT_CONTROVERSY=0.15
# SCORE_WEIGHT_SENTIMENT=0.15
# BUY_SCORE_THRESHOLD=60        # score >= this → derived binary verdict is BUY

# ── Langfuse tracing (optional) ─────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com   # EU region; use https://us.cloud.langfuse.com for US
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_TRACING_ENVIRONMENT=development
